{
  "name": "flow-landing",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "remix vite:dev",
    "start": "remix-serve ./build/server/index.js",
    "typecheck": "tsc",
    "seed": "tsx app/data/seed.ts",
    "seed:full": "tsx app/data/seed.ts --upload-images",
    "reconcile": "tsx app/data/reconcile.ts",
    "reconcile:apply": "tsx app/data/reconcile.ts --apply",
    "seed:catalog": "tsx app/data/seed-catalog-html.ts",
    "seed:catalog:apply": "tsx app/data/seed-catalog-html.ts --apply",
    "backfill:variants": "tsx app/data/backfill-variants.ts",
    "backfill:variants:apply": "tsx app/data/backfill-variants.ts --apply"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-email/components": "^1.0.11",
    "@react-email/render": "^2.0.6",
    "@remix-run/node": "^2.15.0",
    "@remix-run/react": "^2.15.0",
    "@remix-run/serve": "^2.15.0",
    "@stripe/react-stripe-js": "^6.1.0",
    "@stripe/stripe-js": "^9.1.0",
    "@supabase/supabase-js": "^2.99.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/remix": "^2.16.7",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "isbot": "^5.1.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.7",
    "resend": "^6.10.0",
    "stripe": "^22.0.1",
    "tailwind-merge": "^3.4.1"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.15.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "dotenv": "^17.3.1",
    "fflate": "^0.8.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
